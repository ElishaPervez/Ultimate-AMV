# Donor projects kept for reference only.
reference/

# moongetsu's PRIVATE Tsukyio AE extension source. Shared in confidence to
# document the vault API — reference only. MUST NOT be committed to the public repo.
Tsukyio-AE-Extension-development/

# Local agent/editor state and internal working documents. Keep these local;
# they are not part of the shipped project.
.claude/
.vscode/
.idea/
.codex
.antigravitycli/
CLAUDE.md
AGENTS.md
/docs/
# Project-manager tool sidecar metadata. Local-only.
.pm.json
# Local LLM scratch dump. Not part of the project.
llm_1000_lines.txt

# OS files.
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files. `logs/` is anchored so it doesn't shadow
# src/features/logs/ : the rule below already covers backend/logs/.
*.log
/logs/
tmp/
temp/
*.tmp
temp.txt
temp.md

# Agent-generated scratch reports at repo root. Local-only.
/TEST_AGENT_PROMPT.md
/TEST_FAILURES.md
/TEST_SUMMARY.md
/regression-report.html
/review-report.html

# Per-release agent changelog scratch (e.g. CHANGELOG-0.13.0.md). The
# canonical CHANGELOG.md (no version suffix) stays tracked.
/CHANGELOG-*.md

